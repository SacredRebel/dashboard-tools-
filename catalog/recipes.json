{
  "version": 1,
  "description": "Business-type recipes for the onboarding flow (START.md). Each is a starting point the agent proposes and the human edits. Gallery ids reference catalog/dashboards.json; themes reference design-system/themes.json; page patterns are named in docs/design/03-page-patterns.md.",
  "recipes": [
    {
      "id": "service-crm",
      "name": "Service business CRM",
      "matches": [
        "coach",
        "consultant",
        "freelancer",
        "agency",
        "photographer",
        "designer",
        "lawyer",
        "accountant",
        "contractor",
        "wedding",
        "clients",
        "leads"
      ],
      "who": "Owner or a small team selling a service to a few dozen clients at a time",
      "job": "See who needs attention today and move every client one step forward",
      "pages": [
        {
          "name": "Today",
          "pattern": "Dashboard",
          "purpose": "KPIs, needs-attention list, upcoming follow-ups"
        },
        {
          "name": "Clients",
          "pattern": "List",
          "purpose": "Search, filter, add; row opens the client"
        },
        {
          "name": "Client",
          "pattern": "Detail",
          "purpose": "Overview, activity, notes, next step"
        },
        {
          "name": "Pipeline",
          "pattern": "Board",
          "purpose": "Stages as columns, drag or 'Move to'"
        },
        {
          "name": "Calendar",
          "pattern": "Calendar",
          "purpose": "Meetings and follow-ups"
        },
        {
          "name": "Settings",
          "pattern": "Settings",
          "purpose": "Stages, profile, import and export"
        }
      ],
      "entities": [
        "client",
        "contact",
        "deal",
        "activity",
        "task",
        "note"
      ],
      "kpis": [
        "Active clients",
        "Open pipeline value",
        "Follow-ups due today",
        "Won this month",
        "Average days to close"
      ],
      "stages": [
        "New lead",
        "Discovery call",
        "Proposal sent",
        "Negotiating",
        "Won",
        "Lost"
      ],
      "integrations": [
        "Google Calendar",
        "Gmail",
        "meeting notes (Fathom, Zoom)",
        "invoicing"
      ],
      "gallery": [
        "orchard-sales",
        "mauve-ledger",
        "kumo-payroll"
      ],
      "themes": [
        "atelier",
        "linen",
        "blush"
      ],
      "notes": "Full blueprint in docs/crm/. Stage names come from the client's own words."
    },
